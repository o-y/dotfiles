# ==============================================================================
# SKHD.ZIG CONFIGURATION
# ==============================================================================
# Note: cmd + space is taken for Raycast

# --- DEFINITIONS ---

.device my_keyboard { vendor: 0x05AC, product: 0x0342 }
.remap caps_lock [device my_keyboard] : f19

# Default leader key for all actions
.alias $mod alt
.alias $secondary_mod ctrl
.alias $chord f19

# Set sequence timeout for chords 
.sequence_timeout 400ms

# --- COMMAND DEFINITIONS ---
.define focus_window         : yabai -m window --focus {{1}} || yabai -m display --focus {{1}}
.define warp_window          : yabai -m window --warp {{1}}
.define insert_window        : yabai -m window --insert {{1}}

.define resize_window_v      : yabai -m window --resize top:0:{{1}}; yabai -m window --resize bottom:0:{{1}}
.define resize_window_h      : yabai -m window --resize right:{{1}}:0; yabai -m window --resize left:{{1}}:0

.define focus_space          : yabai -m space --focus {{1}}
.define send_to_space        : yabai -m window --space {{1}}
.define send_and_focus_space : yabai -m window --space {{1}}; yabai -m space --focus {{1}}

.define toggle_window_state  : yabai -m window --toggle {{1}}
.define cycle_stack          : yabai -m window --focus stack.{{1}} || yabai -m window --focus stack.{{2}}


# ==============================================================================
# 1. WINDOW FOCUS
# ==============================================================================

# Focus window in direction (North/East/South/West)
$mod - i          : @focus_window("north")
$mod - l          : @focus_window("east")
$mod - k          : @focus_window("south")
$mod - j          : @focus_window("west")

# Focus display in direction
cmd + shift - i   : yabai -m display --focus north
cmd + shift - l   : yabai -m display --focus east
cmd + shift - k   : yabai -m display --focus south
cmd + shift - j   : yabai -m display --focus west

# Focus window under mouse (`)
$mod - 0x32       : yabai -m window --focus mouse

# ==============================================================================
# 2. WINDOW MOVEMENT
# ==============================================================================

# Warp window in direction
$mod + shift - i  : @warp_window("north")
$mod + shift - l  : @warp_window("east")
$mod + shift - k  : @warp_window("south")
$mod + shift - j  : @warp_window("west")

# Swap current window with largest/smallest window ([ and ])
$mod - 0x21       : yabai -m window --swap smallest
$mod - 0x1E       : yabai -m window --swap largest


# ==============================================================================
# 3. WINDOW RESIZING
# ==============================================================================

# Shrink / Expand vertically and horizontally
$mod + fn - i     : @resize_window_v("-50")
$mod + fn - l     : @resize_window_h("50")
$mod + fn - k     : @resize_window_v("50")
$mod + fn - j     : @resize_window_h("-50")


# ==============================================================================
# 4. WINDOW INSERTION
# ==============================================================================

#
# Set insertion point of new window for focused container
#
# DISABLED - I never used this, $mod + $secondary_mod is better used elsewhere.
#
# $mod + $secondary_mod - i   : @insert_window("north")
# $mod + $secondary_mod - l   : @insert_window("east")
# $mod + $secondary_mod - k   : @insert_window("south")
# $mod + $secondary_mod - j   : @insert_window("west")


# ==============================================================================
# 5. SPACES MANAGEMENT
# ==============================================================================

# Focus a space
$chord, 1   : @focus_space("1")
$chord, 2   : @focus_space("2")
$chord, 3   : @focus_space("3")
$chord, 4   : @focus_space("4")
$chord, 5   : @focus_space("5")
$chord, 6   : @focus_space("6")
$chord, 7   : @focus_space("7")
$chord, 8   : @focus_space("8")
$chord, 9   : @focus_space("9")

# Send window to space AND follow
$chord, 1, 1  : @send_and_focus_space("1")
$chord, 2, 2  : @send_and_focus_space("2")
$chord, 3, 3  : @send_and_focus_space("3")
$chord, 4, 4  : @send_and_focus_space("4")
$chord, 5, 5  : @send_and_focus_space("5")
$chord, 6, 6  : @send_and_focus_space("6")
$chord, 7, 7  : @send_and_focus_space("7")
$chord, 8, 8  : @send_and_focus_space("8")
$chord, 9, 9  : @send_and_focus_space("9")

# Go back to recent space
$mod - z          : yabai -m space --focus recent

# Send window to recent space and follow focus
$mod + shift - z  : yabai -m window --space recent; yabai -m space --focus recent

# Create a new space at the end and focus it
$mod - n          : yabai -m space --create; yabai -m space --focus $(yabai -m query --spaces | jq '.[-1].index')

# Destroy the current space (windows move to remaining spaces)
$mod + shift - n  : yabai -m space --destroy


# ==============================================================================
# 6. LAYOUT & WINDOW STATE
# ==============================================================================

# Toggle split type / Balance space
$mod - s          : @toggle_window_state("split")
$mod - e          : yabai -m space --balance

# Rotate / Mirror spaces
$mod - r          : yabai -m space --rotate 270
$mod + shift - r  : yabai -m space --rotate 90
$mod - d          : yabai -m space --mirror x-axis
$mod - f          : yabai -m space --mirror y-axis

# Toggle zoom states
$mod - a          : @toggle_window_state("zoom-parent")
$mod - q          : @toggle_window_state("zoom-fullscreen")

# Float / Unfloat window and center on screen
$mod - w          : yabai -m window --toggle float; yabai -m window --grid 4:4:1:1:2:2

# Make floating window fill screen
$mod + shift - w  : yabai -m window --grid 1:1:0:0:1:1

# Toggle sticky(+float), topmost, picture-in-picture
$mod - p          : yabai -m window --toggle sticky; yabai -m window --toggle topmost; yabai -m window --toggle pip

# Deminimize window
$mod - m  : id=$(yabai -m query --windows | jq -re '.[] | select(.["is-minimized"] == true) | .id' | head -n 1); [ -n "$id" ] && yabai -m window --deminimize "$id"


# ==============================================================================
# 7. STACKS & SYSTEM
# ==============================================================================

# Cycle backward/forward through the current stack
$mod + cmd - j    : @cycle_stack("prev", "last")
$mod + cmd - l    : @cycle_stack("next", "first")

# Toggle stack script
$mod + cmd - s    : ~/.config/yabai/scripts/toggle_stack.zsh

# Restart Yabai service
$mod - c          : yabai --restart-service